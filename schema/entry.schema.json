{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olitreadwell/tech-for-good-job-sites/schema/entry.schema.json",
  "title": "Job site directory entry",
  "description": "One job search site in the directory.",
  "type": "object",
  "required": ["name", "url", "status", "category", "apply_type", "source", "checked"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "Site host, e.g. remoteok.io." },
    "url": { "type": "string", "format": "uri", "description": "Verified URL of the site." },
    "status": {
      "type": "string",
      "enum": ["live", "blocked", "dead"],
      "description": "live = 2xx/3xx; blocked = site up but bot-blocked (403/429); dead = 404, 5xx, DNS/TLS, timeout."
    },
    "category": {
      "type": "string",
      "enum": ["job-board", "aggregator", "company-careers", "ats", "resource"],
      "description": "What kind of site it is."
    },
    "apply_type": {
      "type": "string",
      "enum": ["quick", "ats", "unknown"],
      "description": "How applications happen: quick = one-click/email, ats = application form, unknown."
    },
    "source": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Upstream list(s) that contributed this URL, or 'user'."
    },
    "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date of last link check." },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Open-ended facets, e.g. 4-day-week, employee-owned, cooperative."
    }
  }
}
